# ===============================
# Etapa 1 - Build das dependências do Laravel
# ===============================
FROM composer:2.6 AS vendor

WORKDIR /app
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --no-progress --no-interaction --prefer-dist

# ===============================
# Etapa 2 - PHP com extensões necessárias
# ===============================
FROM php:8.2-fpm

# Instalar dependências do sistema e extensões PHP
RUN apt-get update && apt-get install -y \
    zip unzip git curl libpng-dev libxml2-dev libonig-dev netcat-openbsd nano \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ===============================
# Configuração de timezone
# ===============================
ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# ===============================
# Configurar diretório de trabalho
# ===============================
WORKDIR /var/www/html

# Copiar arquivos do Laravel
COPY backend/ ./

# Copiar dependências do Composer da etapa anterior
COPY --from=vendor /app/vendor ./vendor

# ===============================
# Ajustar permissões iniciais (storage e cache)
# ===============================
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 775 storage bootstrap/cache

# ============================================
# 🔐 Corrigir permissões e link simbólico do storage
# ============================================
# Cria pastas necessárias, aplica permissões corretas e garante link público
RUN mkdir -p /var/www/html/storage/app/public /var/www/html/bootstrap/cache /var/www/html/public && \
    chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache /var/www/html/public && \
    chown -R www-data:www-data /var/www/html && \
    if [ ! -L /var/www/html/public/storage ]; then \
        ln -s /var/www/html/storage/app/public /var/www/html/public/storage && \
        echo "✅ Link simbólico criado manualmente para storage."; \
    else \
        echo "ℹ️ Link simbólico já existe."; \
    fi && \
    echo "✅ Permissões e estrutura do storage configuradas com sucesso."

# ===============================
# Copiar entrypoint customizado
# ===============================
COPY ./backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh
RUN chmod +x /usr/local/bin/backend-entrypoint.sh

# ===============================
# Suporte a AMBIENTE DE DESENVOLVIMENTO LOCAL
# ===============================
# Permitir usar npm, artisan serve e hot reload localmente dentro do container
RUN apt-get update && apt-get install -y npm nodejs && npm install -g npm@latest

# Copiar .env para dentro do container apenas em modo dev
ARG APP_ENV=production
ENV APP_ENV=${APP_ENV}

# ===============================
# Modo de execução dinâmico (dev/prod)
# ===============================
CMD if [ "$APP_ENV" = "local" ]; then \
        echo "🚀 Iniciando Laravel em modo desenvolvimento..."; \
        php artisan serve --host=0.0.0.0 --port=8000; \
    else \
        echo "🏭 Iniciando Laravel em modo produção..."; \
        /usr/local/bin/backend-entrypoint.sh; \
    fi

# ===============================
# Porta exposta (Backend Laravel)
# ===============================
EXPOSE 8000

# ===============================
# Entrypoint padrão (produção)
# ===============================
ENTRYPOINT ["/usr/local/bin/backend-entrypoint.sh"]
