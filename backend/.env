# ====== Configuração da Aplicação ======
APP_NAME="Cotação Mercado"
APP_ENV=local
APP_KEY=base64:pERnyhGEFE5X2JFO/NKH1uuw6VFDItNuh4sTHkDUHSU=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ====== Idiomas ======
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# ====== Logs ======
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ====== Banco de Dados (MySQL - Desenvolvimento/Produção) ======
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mercprodutos
DB_USERNAME=root
DB_PASSWORD=123

# ====== Sessões ======
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

# ====== Cache / Filas ======
CACHE_STORE=database
QUEUE_CONNECTION=database

# ====== Redis (opcional) ======
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ====== E-mail (desenvolvimento usa log) ======
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ====== Frontend (Vite/TS) ======
VITE_APP_NAME="${APP_NAME}"

# ====== SANCTUM / CORS (Autenticação) ======
# Domínios considerados "stateful" (onde o Sanctum mantém autenticação)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,app_produtos_front:5173

# Domínio das sessões (precisa ser igual ao SANCTUM_STATEFUL_DOMAINS)
SESSION_DOMAIN=localhost

# CORS — Domínios permitidos a acessar a API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://app_produtos_front:5173

# Modo API Bearer Token — sem cookies, mas com CORS liberado
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Requested-With

# ====== Fuso horário ======
APP_TIMEZONE=America/Sao_Paulo
